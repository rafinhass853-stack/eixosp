rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O login cria uma sessão Firebase Authentication no backend.
    // Acesso autenticado aos módulos existentes do EixoSP.
    // Atenção: estas regras liberam leitura e gravação de todas as coleções
    // para qualquer conta autenticada; restrinja por perfil/coleção antes
    // de armazenar ou expor dados pessoais e financeiros em produção.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
