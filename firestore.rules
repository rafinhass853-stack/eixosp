rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email == 'rafinhass853@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /multas/{id} {
      allow read, create, update: if owner();
      allow delete: if false;
    }
    match /condutores/{id} {
      allow read, create, update: if owner();
      allow delete: if false;
    }
    match /veiculos/{id} {
      allow read, create, update: if owner();
      allow delete: if false;
    }
    match /funcionarios/{id} {
      allow read, create, update: if owner();
      allow delete: if false;
    }
    match /auditoria_multas/{id} {
      allow read, create: if owner();
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
