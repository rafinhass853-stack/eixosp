rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fail closed: matrícula digitada e localStorage não são credenciais confiáveis.
    // Nenhum acesso direto do navegador a documentos é liberado por estas regras.
    // Para habilitar os módulos, implemente autenticação real e regras por coleção
    // com claims/roles emitidas exclusivamente por backend confiável.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
