rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email == 'rafinhass853@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // A conta proprietária pode importar e consultar coleções de primeiro nível.
    // Exclusões ficam bloqueadas para preservar dados e histórico.
    match /{collectionName}/{id} {
      allow read, create, update: if owner() && collectionName != 'auditoria_multas';
      allow delete: if false;
    }

    // Auditoria não pode ser editada nem apagada.
    match /auditoria_multas/{id} {
      allow read, create: if owner();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
